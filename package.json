{
  "name": "our-little-universe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A private, two-person relationship web app.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/tests/run-local.sh",
    "test:backup": "bash supabase/tests/backup-roundtrip.sh",
    "partner-key": "tsx scripts/partner-key.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.73.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
