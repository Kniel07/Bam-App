# Copy to .env.local for local development. Never commit real values.
# Public (shipped to the browser; safe because access is enforced by RLS):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public key (CR-04). Public by design; the private key is a Supabase function secret.
VITE_VAPID_PUBLIC_KEY=

# Owner's machine only (partner key script). NEVER put this in Vercel or git.
SUPABASE_SERVICE_ROLE_KEY=

# Backups (S6): KEEPALIVE_*, SUPABASE_DB_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# BACKUP_AGE_RECIPIENT are GitHub Actions secrets, not local values (SETUP-GUIDE Part G).
# The restore drill reads TARGET_DB_URL, TARGET_SUPABASE_URL, TARGET_SERVICE_ROLE_KEY from
# your terminal session only.
